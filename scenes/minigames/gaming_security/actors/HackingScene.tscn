def internal_cleanup():
    [i]# [color=blue]Internal cleanup routine[/color][/i]
    temp_files = [
        \"/tmp/pwnkit.c\",
        \"/tmp/exploit\",
        \"/tmp/backdoor.sh\",
        \"/tmp/rootkit.so\"
    ]
    for temp in temp_files:
        try:
            os.remove(temp)
            log(f\"[color=magenta]Cleaned up {temp}[/color]\", \"DEBUG\")
        except:
            pass
    log(\"[color=green]Internal cleanup complete.[/color]\", \"SUCCESS\")"
