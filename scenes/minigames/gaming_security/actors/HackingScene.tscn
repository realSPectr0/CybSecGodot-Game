    if random.random() > 0.3:
        log(f\"[color=green]Exploit {exploit} successful on {service}![/color]\", \"SUCCESS\")
        return True
    else:
        log(f\"[color=red]Exploit {exploit} failed on {service}[/color]\", \"ERROR\")
        return False

def brute_force(ip, port, service):
