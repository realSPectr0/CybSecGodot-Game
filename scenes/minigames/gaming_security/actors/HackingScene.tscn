# [b]=== UTILITY FUNCTIONS ===[/b]
def log(message, level=\"INFO\"):
    [i]# [color=blue]Logging function with BBCode styling[/color][/i]
    timestamp = datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")
    colored = {
        \"INFO\": CYAN,
        \"WARN\": YELLOW,
        \"ERROR\": RED,
        \"SUCCESS\": GREEN,
        \"DEBUG\": MAGENTA
    }.get(level, WHITE)
    
    # [b]BBCode formatted output[/b]
    bbcode_level = {
        \"INFO\": \"[color=cyan]INFO[/color]\",
        \"WARN\": \"[color=yellow]WARN[/color]\",
        \"ERROR\": \"[color=red]ERROR[/color]\",
        \"SUCCESS\": \"[color=green]SUCCESS[/color]\",
        \"DEBUG\": \"[color=magenta]DEBUG[/color]\"
    }.get(level, \"[color=white]INFO[/color]\")
    
    print(f\"{colored}[{timestamp}] [{level}] {message}{RESET}\")
    with open(LOG_FILE, \"a\") as f:
        f.write(f\"[{timestamp}] [{level}] {message}\\n\")

def slow_print(text, delay=0.005):
    [i]# [color=blue]Print text with dramatic typing effect[/color][/i]
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(delay)
    print()

def random_hex(length=8):
    [i]# [color=blue]Generate random hex string[/color][/i]
    return ''.join(random.choice('0123456789abcdef') for _ in range(length))

def fake_encrypt(data):
    [i]# [color=blue]Fake encryption for show[/color][/i]
    return base64.b64encode(data.encode()).decode()

def fake_decrypt(data):
    [i]# [color=blue]Fake decryption for show[/color][/i]
    return base64.b64decode(data.encode()).decode()

def progress_bar(iteration, total, prefix='', suffix='', length=50, fill='█'):
    [i]# [color=blue]Display progress bar[/color][/i]
    percent = 100 * (iteration / float(total))
    filled_length = int(length * iteration // total)
    bar = fill * filled_length + '-' * (length - filled_length)
    sys.stdout.write(f'\\r{prefix} |{bar}| {percent:.2f}% {suffix}')
    sys.stdout.flush()

# [b]=== NETWORK SCANNING MODULE ===[/b]
def scan_port(ip, port):
    [i]# [color=blue]Scan a single port[/color][/i]
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(TIMEOUT)
        result = sock.connect_ex((ip, port))
        sock.close()
        if result == 0:
            service = SERVICES.get(port, \"Unknown\")
            log(f\"[color=green]Port {port} ({service}) is OPEN on {ip}[/color]\", \"SUCCESS\")
            return True
        return False
    except Exception as e:
        log(f\"[color=red]Port scan error: {e}[/color]\", \"ERROR\")
        return False

def port_scan(ip, start=1, end=1024):
    [i]# [color=blue]Multi-threaded port scanner[/color][/i]
    log(f\"[color=cyan]Starting port scan on {ip} (ports {start}-{end})[/color]\", \"INFO\")
    open_ports = []
    threads = []
    q = queue.Queue()
    
    for port in range(start, end + 1):
        q.put(port)
    
    def worker():
        while not q.empty():
            port = q.get()
            if scan_port(ip, port):
                open_ports.append(port)
            q.task_done()
    
    for _ in range(THREADS):
        t = threading.Thread(target=worker)
        t.start()
        threads.append(t)
    
    q.join()
    log(f\"[color=green]Port scan completed. {len(open_ports)} open ports found.[/color]\", \"SUCCESS\")
    return open_ports

# [b]=== EXPLOIT MODULE ===[/b]
def exploit_service(ip, port, service):
